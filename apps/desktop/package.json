{
  "name": "@livefy/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:main": "node electron/build-main.mjs",
    "desktop:dev": "node electron/build-preload.mjs && node electron/build-main.mjs && electron . --livefy-dev",
    "start": "node electron/build-preload.mjs && node electron/build-main.mjs && electron .",
    "build": "vite build && node electron/build-preload.mjs && node electron/build-main.mjs",
    "dist:win": "bun run build && electron-builder --win",
    "dist:win:unpacked": "bun run build && electron-builder --win dir",
    "typecheck": "tsc --noEmit && node --check electron/main.cjs && node --check electron/security.cjs && node --check electron/live-surface.cjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/electron": "0.0.51",
    "@clerk/react": "6.17.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "1.46.0",
    "convex-test": "0.0.60",
    "electron": "41.10.7",
    "electron-builder": "^26.18.0",
    "electron-store": "8.2.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
